# ─── HirePakistan environment ─────────────────────────────────────────────
# Copy to .env and fill in. Never commit real values.

# Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon (publishable) key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key — SERVER ONLY. Never import into client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of the app (used for email links, redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# One-time bootstrap: email of the first super admin (used by scripts/bootstrap-admin.ts)
BOOTSTRAP_ADMIN_EMAIL=owner@example.com

# ─── Email (optional) ─────────────────────────────────────────────────────────
# When RESEND_API_KEY is unset, lib/email.ts returns { sent: false, reason: 'email_unconfigured' }
# and no send is ever attempted or claimed.
EMAIL_FROM_ADDRESS=noreply@example.com
RESEND_API_KEY=

# ─── Chat AI fallback (optional) ──────────────────────────────────────────────
# GROQ_API_KEY enables AI answers for off-topic chat questions in the
# TalentBridge Assistant (knowledge-base answers stay primary). When unset,
# the chat API reports itself disabled and the widget uses its normal fallback.
GROQ_API_KEY=
# Optional: Groq model override (defaults to llama-3.3-70b-versatile)
GROQ_MODEL=

# ─── Dev seed data (optional) ─────────────────────────────────────────────────
# scripts/seed.ts refuses to run unless this is exactly "yes"
SEED_CONFIRM=no
